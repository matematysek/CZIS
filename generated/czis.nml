    tilelayout orchard_piggery_layout_1_tilelayout {
        
            0, 0: orchard_piggery_tile_1;
        
            0, 1: orchard_piggery_tile_1;
        
            0, 2: orchard_piggery_tile_1;
        
            1, 0: orchard_piggery_tile_1;
        
            1, 1: orchard_piggery_tile_2;
        
            1, 2: orchard_piggery_tile_1;
        
            2, 1: orchard_piggery_tile_2;
        
            2, 2: orchard_piggery_tile_2;
        
    }

    tilelayout orchard_piggery_layout_2_tilelayout {
        
            0, 0: orchard_piggery_tile_1;
        
            0, 1: orchard_piggery_tile_1;
        
            0, 2: orchard_piggery_tile_1;
        
            0, 3: orchard_piggery_tile_2;
        
            1, 1: orchard_piggery_tile_1;
        
            1, 2: orchard_piggery_tile_1;
        
            1, 3: orchard_piggery_tile_2;
        
            1, 4: orchard_piggery_tile_2;
        
    }

