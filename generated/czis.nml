        item(FEAT_INDUSTRIES, component_factory, 55) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 166;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [component_factory_industry_layout_1_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_COMPONENT_FACTORY);
                prob_map_gen: 8;
                prob_in_game: 7;
                
                fund_cost_multiplier: 95;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("STSE", produce_cargo("VPTS", 0.33)),accept_cargo("PLAS", produce_cargo("VPTS", 0.33)),accept_cargo("STAL", produce_cargo("VPTS", 0.5)),accept_cargo("POWR", produce_cargo("VPTS", 0.25))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_COMPONENTS));
            }
        }







    
        item(FEAT_INDUSTRIES, component_factory, 55) {
            graphics {
                construction_probability: component_factory_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      component_factory_extra_text;
                cargo_subtype_display:    component_factory_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }

