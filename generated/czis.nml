        item(FEAT_INDUSTRIES, quarry, 7) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 194;
                life_type: IND_LIFE_TYPE_EXTRACTIVE;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [quarry_layout_1_tilelayout,quarry_layout_2_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_QUARRY);
                prob_map_gen: 7;
                prob_in_game: 4;
                prospect_chance: 0.75;
                fund_cost_multiplier: 210;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("ENSP", produce_cargo("SAND",4), produce_cargo("LIME",4), produce_cargo("GRVL",4)), produce_cargo("SAND",20), produce_cargo("LIME",37), produce_cargo("GRVL",40)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_IND_QUARRY));
            }
        }
    





    
        item(FEAT_INDUSTRIES, quarry, 7) {
            graphics {
                construction_probability: quarry_check_availability;

                
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      quarry_extra_text;
                cargo_subtype_display:    quarry_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

