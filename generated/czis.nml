        date(0,1,1) .. date(5000000,12,31): coke_oven_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, coke_oven_check_availability, 5) {
    
