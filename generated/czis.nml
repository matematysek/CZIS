}







    
        item(FEAT_INDUSTRIES, slag_grinding_plant, 51) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 19;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [slag_grinding_plant_industry_layout_1_tilelayout,slag_grinding_plant_industry_layout_2_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS,IND_FLAG_MILITARY_AIRPLANE_CAN_EXPLODE);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_SLAG_GRINDING_PLANT);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 100 ;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("SLAG",produce_cargo("CMNT",0.3))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_SILO));
            }
        }
    





    
        item(FEAT_INDUSTRIES, slag_grinding_plant, 51) {
            graphics {
                construction_probability: slag_grinding_plant_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      slag_grinding_plant_extra_text;
                cargo_subtype_display:    slag_grinding_plant_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

