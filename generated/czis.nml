            0, 0: arable_farm_tile_1;
        
            0, 1: arable_farm_tile_1;
        
            1, 0: arable_farm_tile_1;
        
            1, 1: arable_farm_tile_1;
        
            2, 0: arable_farm_tile_1;
        
    }

