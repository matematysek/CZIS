        3: factory_1_industry_layout_3_graphics_switch;
    
    factory_1_industry_layout_1_graphics_switch; // default
}


switch(FEAT_INDUSTRYTILES, SELF, factory_1_industry_construction_state_graphics_switch, construction_state) {
