switch(FEAT_INDUSTRYTILES, PARENT, dairy_farm_industry_graphics_switch_layouts, layout_num) {
    
        1: dairy_farm_industry_layout_1_graphics_switch;
    
        2: dairy_farm_industry_layout_2_graphics_switch;
    
        3: dairy_farm_industry_layout_3_graphics_switch;
    
    dairy_farm_industry_layout_1_graphics_switch; // default
}


switch(FEAT_INDUSTRYTILES, SELF, dairy_farm_industry_construction_state_graphics_switch, construction_state) {
    0..2: spritelayout_default_construction_states;
    
    dairy_farm_industry_graphics_switch_layouts; // default
}

switch(FEAT_INDUSTRYTILES, SELF, dairy_farm_store_temp_vars,
        [STORE_TEMP(random_bits, 14),
         STORE_TEMP(terrain_type == TILETYPE_SNOW, 13)
            
                , STORE_TEMP(0,
                             127) 
                , STORE_TEMP(construction_state != 3 ? 1 : LOAD_TEMP(127),
                             127)
                , STORE_TEMP(LOAD_TEMP(13) == 0 ? 1 : LOAD_TEMP(127), 
                             117) 
                , STORE_TEMP(LOAD_TEMP(13) == 1 ? 1 : LOAD_TEMP(127), 
                             127)
            
        ]) {
    dairy_farm_industry_construction_state_graphics_switch; // default
}

switch (FEAT_INDUSTRYTILES, SELF, dairy_farm_switch_graphics, [
                                    switch_tile_fences(),
                                    switch_terrain_sprite(),
                                    
                                 ]) {
    dairy_farm_store_temp_vars;
}



    
        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, dairy_farm_tile_1_lc_5,
            (nearby_tile_class( 2,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2, -2) == TILE_CLASS_INDUSTRY)
        ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        return CB_RESULT_LOCATION_ALLOW;
    }

        
            
    
    switch (FEAT_INDUSTRYTILES, PARENT, dairy_farm_tile_1_lc_4, (
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_FUND) ||
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_PROSPECT)
                )
            ) {
        1: return CB_RESULT_LOCATION_ALLOW;
        dairy_farm_tile_1_lc_5;
    }

        
            
    
    switch (FEAT_INDUSTRYTILES, SELF, dairy_farm_tile_1_lc_3, nearby_tile_slope(0,0) & bitmask(IS_STEEP_SLOPE)) {
        0: dairy_farm_tile_1_lc_4;
        return string(STR_ERR_LOCATION_NOT_ON_STEEP_SLOPE);
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, dairy_farm_tile_1_lc_2, UCMP(nearby_tile_height(0, 0) - 0, snowline_height - 0)) {
        0..1: dairy_farm_tile_1_lc_3;
        return string(STR_ERR_LOCATION_NOT_ABOVE_SNOWLINE);
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, dairy_farm_tile_1_lc_1,
                (nearby_tile_terrain_type( 1, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 1,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 1,  1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0,  1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1,  1) == TILETYPE_DESERT)
            ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        dairy_farm_tile_1_lc_2;
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, dairy_farm_tile_1_lc_0, nearby_tile_is_water(0, 0)) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        dairy_farm_tile_1_lc_1;
    }

        
    



    
        
    



    
    item(FEAT_INDUSTRYTILES, dairy_farm_tile_1, 180) {
        property {
            substitute:         0;
            land_shape_flags:   0;
            special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
            
            
            
            animation_triggers: bitmask();
        }

        graphics {
    		
    		    tile_check: dairy_farm_tile_1_lc_0;
            
            
    		
            
    		
    		
            dairy_farm_switch_graphics;
        }
    }




/* *************************************************
 * Definition of the industry
 * *************************************************/


    tilelayout dairy_farm_industry_layout_1_tilelayout {
        
            0, 0: dairy_farm_tile_1;
        
            0, 1: dairy_farm_tile_1;
        
            0, 2: dairy_farm_tile_1;
        
            2, 0: dairy_farm_tile_1;
        
            2, 1: dairy_farm_tile_1;
        
            3, 0: dairy_farm_tile_1;
        
            3, 1: dairy_farm_tile_1;
        
            3, 2: dairy_farm_tile_1;
        
    }

    tilelayout dairy_farm_industry_layout_2_tilelayout {
        
            0, 0: dairy_farm_tile_1;
        
            0, 1: dairy_farm_tile_1;
        
            0, 2: dairy_farm_tile_1;
        
            1, 1: dairy_farm_tile_1;
        
            1, 2: dairy_farm_tile_1;
        
            2, 0: dairy_farm_tile_1;
        
            2, 1: dairy_farm_tile_1;
        
            2, 2: dairy_farm_tile_1;
        
    }

    tilelayout dairy_farm_industry_layout_3_tilelayout {
        
            0, 1: dairy_farm_tile_1;
        
            0, 3: dairy_farm_tile_1;
        
            1, 0: dairy_farm_tile_1;
        
            1, 1: dairy_farm_tile_1;
        
            1, 3: dairy_farm_tile_1;
        
            2, 0: dairy_farm_tile_1;
        
            2, 1: dairy_farm_tile_1;
        
            2, 3: dairy_farm_tile_1;
        
    }





switch(FEAT_INDUSTRIES, SELF, dairy_farm_extra_text, [
	STORE_TEMP((primary_level1_requirement * 1) |
	(primary_level2_requirement * 1) << 16, 0x100),
	LOAD_PERM(3)
]) {
	primary_level2_produced_percent: return string(STR_PRIMARY_PRODUCTION_4X);
	primary_level1_produced_percent: return string(STR_PRIMARY_PRODUCTION_2X);
	return string(STR_PRIMARY_PRODUCTION_1X);
}




    
    
        switch (FEAT_INDUSTRIES, SELF, dairy_farm_cargo_subtype_display_cargo_FMSP_economy_5, [
                LOAD_PERM(4)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
    switch (FEAT_INDUSTRIES, SELF, dairy_farm_cargo_subtype_display_switch_cargo_economy_5, getbits(extra_callback_info2, 16, 8)) {
        
        
            FMSP: dairy_farm_cargo_subtype_display_cargo_FMSP_economy_5;
        
        return CB_RESULT_NO_TEXT;
    }


switch (FEAT_INDUSTRIES, SELF, dairy_farm_cargo_subtype_display_switch_economy, 5) {
    
