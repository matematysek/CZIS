    switch(FEAT_INDUSTRYTILES, SELF, farm_industry_layout_1_graphics_switch, relative_pos) {
        
            
            
                relative_coord(0, 2): farm_spritelayout_8;
            
        
            
            
                relative_coord(0, 3): farm_spritelayout_3;
            
        
            
            
                relative_coord(1, 0): farm_spritelayout_2;
            
        
            
            
                relative_coord(2, 0): farm_spritelayout_1;
            
        
            
            
                relative_coord(2, 2): farm_spritelayout_5;
            
        
            
            
                relative_coord(2, 3): farm_spritelayout_7;
            
        
            
            
                relative_coord(3, 2): farm_spritelayout_6;
            
        
            
            
                relative_coord(3, 3): farm_spritelayout_4;
            
        
        return 0; // a default is needed, but should never be reached, layout definitions are explicit
    }

    switch(FEAT_INDUSTRYTILES, SELF, farm_industry_layout_2_graphics_switch, relative_pos) {
        
            
            
                relative_coord(0, 0): farm_spritelayout_4;
            
        
            
            
                relative_coord(0, 2): farm_spritelayout_7;
            
        
            
            
                relative_coord(0, 3): farm_spritelayout_6;
            
        
            
            
                relative_coord(1, 0): farm_spritelayout_5;
            
        
            
            
                relative_coord(1, 3): farm_spritelayout_1;
            
        
            
            
                relative_coord(2, 0): farm_spritelayout_8;
            
        
            
            
                relative_coord(2, 1): farm_spritelayout_3;
            
        
            
            
                relative_coord(2, 2): farm_spritelayout_2;
            
        
        return 0; // a default is needed, but should never be reached, layout definitions are explicit
    }

