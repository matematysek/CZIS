        item(FEAT_INDUSTRIES, port, 27) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 186;
                life_type: IND_LIFE_TYPE_BLACK_HOLE;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [warehouse_industry_layout_1_tilelayout,warehouse_industry_layout_2_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_PORT);
                prob_map_gen: 8;
                prob_in_game: 2;
                prospect_chance: 0.75;
                fund_cost_multiplier: 152;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types:  [accept_cargo("BEER", produce_cargo("NITR",2), produce_cargo("COAT",2), produce_cargo("ACID",3), produce_cargo("AORE",2), produce_cargo("NH3_",3)),accept_cargo("VEHI", produce_cargo("NITR",2), produce_cargo("COAT",2), produce_cargo("ACID",3), produce_cargo("AORE",2), produce_cargo("NH3_",3)),produce_cargo("NITR",20), produce_cargo("COAT",20), produce_cargo("ACID",30), produce_cargo("AORE",20), produce_cargo("NH3_",30)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_INDUSTRY_HARBOUR_2));
            }
        }
    





    
