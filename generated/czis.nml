        item(FEAT_INDUSTRIES, clay_pit, 30) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 45;
                life_type: IND_LIFE_TYPE_EXTRACTIVE;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [clay_pit_layout_1_tilelayout,clay_pit_layout_2_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_CLAY_PIT);
                prob_map_gen: 7;
                prob_in_game: 4;
                prospect_chance: 0.75;
                fund_cost_multiplier: 200;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("ENSP", produce_cargo("KAOL",3),produce_cargo("CLAY",3)),(produce_cargo("KAOL",20)),produce_cargo("CLAY",20)];
