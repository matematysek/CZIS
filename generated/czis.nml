    switch(FEAT_INDUSTRYTILES, SELF, supply_yard_industry_layout_1_graphics_switch, relative_pos) {
        
            
            
                relative_coord(0, 0): supply_yard_spritelayout_1;
            
        
            
            
                relative_coord(0, 1): supply_yard_spritelayout_2;
            
        
            
            
