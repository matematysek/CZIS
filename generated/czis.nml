        item(FEAT_INDUSTRIES, copper_refinery, 44) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 64;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [copper_refinery_industry_layout_1_tilelayout,copper_refinery_industry_layout_2_tilelayout,copper_refinery_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_COPPER_REFINERY);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 200;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo ("RFPR"),accept_cargo("CORE", produce_cargo("COPR", 0.5), produce_cargo("SULP", 0.5))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_SMELTER));
            }
        }
 





    
