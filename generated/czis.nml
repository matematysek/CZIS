        item(FEAT_INDUSTRIES, aluminium_plant, 5) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 19;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [aluminium_plant_industry_layout_1_tilelayout,aluminium_plant_industry_layout_2_tilelayout,aluminium_plant_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_ALUMINIUM_PLANT);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 200;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("AORE", produce_cargo("ALUM", 1), produce_cargo("SLAG", 0.5)),accept_cargo("ACID", produce_cargo("SLAG", 0.5))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_SMELTER));
            }
        }





    
        item(FEAT_INDUSTRIES, aluminium_plant, 5) {
            graphics {
                construction_probability: aluminium_plant_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      aluminium_plant_extra_text;
               cargo_subtype_display:    aluminium_plant_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

