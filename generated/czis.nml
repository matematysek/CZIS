        switch (FEAT_INDUSTRIES, SELF, steel_mill_cargo_subtype_display_cargo_LIME_economy_5, [
                LOAD_PERM(5)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
    switch (FEAT_INDUSTRIES, SELF, steel_mill_cargo_subtype_display_switch_cargo_economy_5, getbits(extra_callback_info2, 16, 8)) {
        
        
            IORE: steel_mill_cargo_subtype_display_cargo_IORE_economy_5;
        
            COKE: steel_mill_cargo_subtype_display_cargo_COKE_economy_5;
        
            LIME: steel_mill_cargo_subtype_display_cargo_LIME_economy_5;
        
        return CB_RESULT_NO_TEXT;
    }


switch (FEAT_INDUSTRIES, SELF, steel_mill_cargo_subtype_display_switch_economy, 5) {
    
        5:  steel_mill_cargo_subtype_display_switch_cargo_economy_5;
    
}


switch (FEAT_INDUSTRIES, SELF, steel_mill_cargo_subtype_display, getbits(extra_callback_info2, 8, 8)) {
    1: steel_mill_cargo_subtype_display_switch_economy;
    return CB_RESULT_NO_TEXT;
}







switch(FEAT_INDUSTRIES, SELF, steel_mill_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, steel_mill_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	steel_mill_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, steel_mill_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: steel_mill_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, steel_mill_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): steel_mill_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, steel_mill_check_availability, 5) {
    
        5: steel_mill_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, integrated_steel_mill, 2) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 160;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [steel_mill_industry_layout_1_tilelayout,steel_mill_industry_layout_2_tilelayout,steel_mill_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_INTEGRATED_STEEL_MILL);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 120;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("IORE",produce_cargo("STEL",0.5)),accept_cargo("COAL"),accept_cargo("SCMT",produce_cargo("STEL",0.4))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_FURNACE));
            }
        }
    





    
        item(FEAT_INDUSTRIES, integrated_steel_mill, 2) {
            graphics {
                construction_probability: steel_mill_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      steel_mill_extra_text;
                cargo_subtype_display:    steel_mill_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

