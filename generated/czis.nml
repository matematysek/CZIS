switch(FEAT_INDUSTRIES, SELF, coke_oven_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, coke_oven_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	coke_oven_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, coke_oven_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: coke_oven_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



