                relative_coord(1, 2): supply_yard_spritelayout_6;
            
        
            
            
                relative_coord(1, 3): supply_yard_spritelayout_2;
            
        
        return 0; // a default is needed, but should never be reached, layout definitions are explicit
    }

    switch(FEAT_INDUSTRYTILES, SELF, supply_yard_industry_layout_2_graphics_switch, relative_pos) {
        
            
            
                relative_coord(0, 0): supply_yard_spritelayout_1;
            
        
            
            
