        3: brewery_industry_layout_3_graphics_switch;
    
        4: brewery_industry_layout_4_graphics_switch;
    
        5: brewery_industry_layout_5_graphics_switch;
    
    brewery_industry_layout_1_graphics_switch; // default
}


