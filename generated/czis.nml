switch (FEAT_INDUSTRIES, SELF, machine_shop_extra_text, 5) {
    
        5: return string(STR_EXTRA_TEXT_SECONDARY_NON_COMBINATORY);
    
}





    
    
        switch (FEAT_INDUSTRIES, SELF, machine_shop_cargo_subtype_display_cargo_STEL_economy_5, [
                LOAD_PERM(3)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
        switch (FEAT_INDUSTRIES, SELF, machine_shop_cargo_subtype_display_cargo_PETR_economy_5, [
                LOAD_PERM(4)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
    switch (FEAT_INDUSTRIES, SELF, machine_shop_cargo_subtype_display_switch_cargo_economy_5, getbits(extra_callback_info2, 16, 8)) {
        
        
            STEL: machine_shop_cargo_subtype_display_cargo_STEL_economy_5;
        
            PETR: machine_shop_cargo_subtype_display_cargo_PETR_economy_5;
        
        return CB_RESULT_NO_TEXT;
    }


switch (FEAT_INDUSTRIES, SELF, machine_shop_cargo_subtype_display_switch_economy, 5) {
    
        5:  machine_shop_cargo_subtype_display_switch_cargo_economy_5;
    
}


switch (FEAT_INDUSTRIES, SELF, machine_shop_cargo_subtype_display, getbits(extra_callback_info2, 8, 8)) {
    1: machine_shop_cargo_subtype_display_switch_economy;
    return CB_RESULT_NO_TEXT;
}








switch(FEAT_INDUSTRIES, SELF, machine_shop_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, machine_shop_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	machine_shop_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, machine_shop_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: machine_shop_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, machine_shop_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): machine_shop_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, machine_shop_check_availability, 5) {
    
        5: machine_shop_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, machine_shop, 26) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 49;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [machine_shop_industry_layout_1_tilelayout,machine_shop_industry_layout_2_tilelayout,machine_shop_industry_layout_3_tilelayout,machine_shop_industry_layout_4_tilelayout,machine_shop_industry_layout_5_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_MACHINE_SHOP);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 145;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("STEL",produce_cargo("FMSP",0.8),produce_cargo("ENSP",0.8)),accept_cargo("PETR",produce_cargo("FMSP",0.2),produce_cargo("ENSP",0.2))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_HEAVY_EQUIPMENT_YARD));
            }
        }
    





    
        item(FEAT_INDUSTRIES, machine_shop, 26) {
            graphics {
                construction_probability: machine_shop_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      machine_shop_extra_text;
                cargo_subtype_display:    machine_shop_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

/* ******************************************************************
 * Definition of the industry tile, its callbacks, and graphics chain
 * ******************************************************************/


    

    
        
        
    

    

    

    
        
        
    

    

    

    
        
        
            spriteset(machine_works_spriteset_2_0) {
                
                    
                        [10, 60, 64, 70, -31, -39, ANIM | NOCROP, "src/graphics/industries/machine_works_1.png"]
                    
                
            }
            spriteset(machine_works_spriteset_2_0_snow) {
                
                    
                            [10, 60, 64, 70, -31, -39, ANIM | NOCROP, "src/graphics/industries/machine_works_1_snow.png"]
                    
                
            }
        
    

    

    

    
        
        
            spriteset(machine_works_spriteset_3_0) {
                
                    
                        [80, 60, 64, 70, -31, -39, ANIM | NOCROP, "src/graphics/industries/machine_works_1.png"]
                    
                
            }
