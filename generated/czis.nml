        item(FEAT_INDUSTRIES, lime_kiln, 59) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 119;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [lime_kiln_industry_layout_1_tilelayout,lime_kiln_industry_layout_2_tilelayout,lime_kiln_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_LIME_KILN);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 45;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("LIME",produce_cargo("QLME",0.5),produce_cargo("FMSP",0.5)),accept_cargo("PETR",produce_cargo("QLME",0.5),produce_cargo("FMSP",0.5))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_KILNS));
            }
        }
    





    
        item(FEAT_INDUSTRIES, lime_kiln, 59) {
            graphics {
                construction_probability: lime_kiln_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      lime_kiln_extra_text;
                cargo_subtype_display:    lime_kiln_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

