            switch (FEAT_INDUSTRYTILES, SELF, junk_yard_tile_1_lc_3_0, [
                 nearby_tile_class(7, 7) == TILE_CLASS_HOUSE ? STORE_TEMP(1, 0) : 0,
                 LOAD_TEMP(0)
                ]) {
                1: junk_yard_tile_1_lc_3_225;
                return junk_yard_tile_1_lc_3_1;
            }
        
    
    switch (FEAT_INDUSTRYTILES, SELF, junk_yard_tile_1_lc_3, STORE_TEMP(0, 0)) {
        return junk_yard_tile_1_lc_3_0;
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, junk_yard_tile_1_lc_2,
            (nearby_tile_class( 2,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2, -2) == TILE_CLASS_INDUSTRY)
        ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        junk_yard_tile_1_lc_3;
    }

        
            
    
    switch (FEAT_INDUSTRYTILES, PARENT, junk_yard_tile_1_lc_1, (
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_FUND) ||
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_PROSPECT)
                )
            ) {
        1: return CB_RESULT_LOCATION_ALLOW;
        junk_yard_tile_1_lc_2;
    }

        
            
    
    switch (FEAT_INDUSTRYTILES, SELF, junk_yard_tile_1_lc_0, nearby_tile_slope(0,0) & bitmask(IS_STEEP_SLOPE)) {
        0: junk_yard_tile_1_lc_1;
        return string(STR_ERR_LOCATION_NOT_ON_STEEP_SLOPE);
    }

        
    



    
        
    



    
    item(FEAT_INDUSTRYTILES, junk_yard_tile_1, 193) {
        property {
            substitute:         0;
            land_shape_flags:   0;
            special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
            
            
            
            animation_triggers: bitmask();
        }

        graphics {
    		
    		    tile_check: junk_yard_tile_1_lc_0;
            
            
    		
            
    		
    		
            junk_yard_switch_graphics;
        }
    }



/* *************************************************
 * Definition of the industry
 * *************************************************/


    tilelayout junk_yard_industry_layout_1_tilelayout {
        
            0, 2: junk_yard_tile_1;
        
            1, 1: junk_yard_tile_1;
        
            1, 2: junk_yard_tile_1;
        
            2, 1: junk_yard_tile_1;
        
            2, 2: junk_yard_tile_1;
        
            3, 1: junk_yard_tile_1;
        
            3, 2: junk_yard_tile_1;
        
            4, 0: junk_yard_tile_1;
        
            4, 1: junk_yard_tile_1;
        
            4, 2: junk_yard_tile_1;
        
    }

    tilelayout junk_yard_industry_layout_2_tilelayout {
        
            0, 1: junk_yard_tile_1;
        
            1, 1: junk_yard_tile_1;
        
            1, 2: junk_yard_tile_1;
        
            2, 0: junk_yard_tile_1;
        
            2, 1: junk_yard_tile_1;
        
            2, 2: junk_yard_tile_1;
        
    }

    tilelayout junk_yard_industry_layout_3_tilelayout {
        
            0, 3: junk_yard_tile_1;
        
            1, 1: junk_yard_tile_1;
        
            1, 3: junk_yard_tile_1;
        
            2, 1: junk_yard_tile_1;
        
            2, 3: junk_yard_tile_1;
        
            3, 1: junk_yard_tile_1;
        
            3, 3: junk_yard_tile_1;
        
            4, 0: junk_yard_tile_1;
        
            4, 1: junk_yard_tile_1;
        
            4, 3: junk_yard_tile_1;
        
    }






    produce (junk_yard_production_256_economy_5,
        [],
        [
            
                 
                SCMT: min(
                                max(
                                    
                                    LOAD_TEMP(1) * 32 / 16,
                                    
                                    LOAD_TEMP(2)
                                ),
                                
                                LOAD_TEMP(3)
                             );
            
        ],
    0)


switch (FEAT_INDUSTRIES, SELF, junk_yard_produce_cargoswitch_economy, 5) {
    
        5: junk_yard_production_256_economy_5;
    
}

switch(FEAT_INDUSTRIES, PARENT, junk_yard_produce, [
                
                STORE_TEMP((population + 11) / (12 * 7), 1),
                
                STORE_TEMP(64 / 7, 2),
                
                STORE_TEMP(2048 / 9, 3),
            ]
       ) {
	junk_yard_produce_cargoswitch_economy;
}



switch(FEAT_INDUSTRIES, SELF, junk_yard_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, junk_yard_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	junk_yard_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, junk_yard_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: junk_yard_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, junk_yard_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): junk_yard_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, junk_yard_check_availability, 5) {
    
        5: junk_yard_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, junk_yard, 16) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 64;
                
                
                
                
                
                min_cargo_distr: 1;
                layouts: [junk_yard_industry_layout_1_tilelayout,junk_yard_industry_layout_2_tilelayout,junk_yard_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_JUNKYARD);
                prob_map_gen: 10;
                prob_in_game: 3;
                prospect_chance: 0.75;
                fund_cost_multiplier: 101;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [produce_cargo("SCMT",15)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_BONEYARD));
            }
        }
    





    
        item(FEAT_INDUSTRIES, junk_yard, 16) {
            graphics {
                construction_probability:junk_yard_check_availability;
                random_prod_change:      CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:         return CB_RESULT_NO_TEXT;
                extra_text_industry:     return string(STR_EXTRA_TEXT_TOWN_PRODUCER, 64, 2048);
                colour:                  switch_colour;
            }
        }
    

