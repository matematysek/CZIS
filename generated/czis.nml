    [
         STORE_TEMP(farm_produce_cargototal_supplies_delivered(), 8),
         STORE_TEMP((LOAD_TEMP(8) >= (1 * primary_level2_requirement)) ? primary_level2_produced_percent :
                    (LOAD_TEMP(8) >= (1 * primary_level1_requirement)) ? primary_level1_produced_percent : 100, 9),
         STORE_PERM(3, LOAD_TEMP(9)),
    ]) {
    return 0;
}



    produce (farm_clear_incoming_cargo_waiting_5,
        [
            
                
                FMSP: incoming_cargo_waiting("FMSP");
            
        ],
        [],
    0)
    switch(FEAT_INDUSTRIES, SELF, farm_store_incoming_cargo_waiting_5,
        [
            STORE_PERM(
                38,
                
                    incoming_cargo_waiting("FMSP") +
                
                LOAD_PERM(38)
            ),
            
            
                STORE_PERM(
                    4,
                    (incoming_cargo_waiting("FMSP") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(4)
                ),
            
            
            farm_produce_cargocalculate_current_production_level(),
        ]) {
        farm_clear_incoming_cargo_waiting_5;
    }



switch (FEAT_INDUSTRIES, SELF, farm_produce_cargo_arrival, 5) {
    
