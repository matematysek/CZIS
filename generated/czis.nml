        item(FEAT_INDUSTRIES, chemical_plant, 33) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 191;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [chemical_plant_industry_layout_1_tilelayout,chemical_plant_industry_layout_2_tilelayout,chemical_plant_industry_layout_3_tilelayout,chemical_plant_industry_layout_4_tilelayout,chemical_plant_industry_layout_5_tilelayout,chemical_plant_industry_layout_6_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_CHEMICAL_PLANT);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 170;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("PETR", produce_cargo("RFPR", 0.8)),accept_cargo("NH3_", produce_cargo("FMSP", 1)),accept_cargo("NITR", produce_cargo("NHNO", 0.9)),accept_cargo("NITR", produce_cargo("ENSP", 0.5))];
                				    
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_HEAVY_INDUSTRY_2));
            }
        }






    
        item(FEAT_INDUSTRIES, chemical_plant, 33) {
            graphics {
                construction_probability: chemical_plant_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      chemical_plant_extra_text;
                cargo_subtype_display:    chemical_plant_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }


