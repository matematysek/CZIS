        item(FEAT_INDUSTRIES, factory_1, 60) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 166;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [factory_1_industry_layout_1_tilelayout,factory_1_industry_layout_2_tilelayout,factory_1_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_APPLIANCE_FACTORY);
                prob_map_gen: 8;
                prob_in_game: 7;
                
                fund_cost_multiplier: 95;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("PLAS", produce_cargo("GOOD", 0.33)),accept_cargo("STEL", produce_cargo("GOOD", 0.33)),accept_cargo("GLAS", produce_cargo("VPTS", 0.33))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_INDUSTRY_ESTATE_1));
            }
        }






    
        item(FEAT_INDUSTRIES, factory_1, 60) {
