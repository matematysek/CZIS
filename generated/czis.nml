            (nearby_tile_class( -2, -2) == TILE_CLASS_INDUSTRY)
        ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        return CB_RESULT_LOCATION_ALLOW;
    }

        
            
    
    switch (FEAT_INDUSTRYTILES, PARENT, vineyard_tile_1_lc_2, (
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_FUND) ||
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_PROSPECT)
                )
            ) {
        1: return CB_RESULT_LOCATION_ALLOW;
        vineyard_tile_1_lc_3;
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, vineyard_tile_1_lc_1, UCMP(nearby_tile_height(0, 0) - 0, snowline_height - 0)) {
        0..1: vineyard_tile_1_lc_2;
        return string(STR_ERR_LOCATION_NOT_ABOVE_SNOWLINE);
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, vineyard_tile_1_lc_0,
                (nearby_tile_terrain_type( 1, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 1,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 1,  1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0,  1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1,  1) == TILETYPE_DESERT)
            ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        vineyard_tile_1_lc_1;
    }

        
    
        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, vineyard_tile_2_lc_3,
            (nearby_tile_class( 2,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 2, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 1, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( 0, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -1, -2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  2) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2,  0) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2, -1) == TILE_CLASS_INDUSTRY) ||
            (nearby_tile_class( -2, -2) == TILE_CLASS_INDUSTRY)
        ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        return CB_RESULT_LOCATION_ALLOW;
    }

        
            
    
    switch (FEAT_INDUSTRYTILES, PARENT, vineyard_tile_2_lc_2, (
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_FUND) ||
                (((extra_callback_info2 & 0xFF00) >> 8) == IND_CREATION_PROSPECT)
                )
            ) {
        1: return CB_RESULT_LOCATION_ALLOW;
        vineyard_tile_2_lc_3;
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, vineyard_tile_2_lc_1, UCMP(nearby_tile_height(0, 0) - 0, snowline_height - 0)) {
        0..1: vineyard_tile_2_lc_2;
        return string(STR_ERR_LOCATION_NOT_ABOVE_SNOWLINE);
    }

        
            
    
    switch(FEAT_INDUSTRYTILES, SELF, vineyard_tile_2_lc_0,
                (nearby_tile_terrain_type( 1, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 1,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 1,  1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type( 0,  1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1, -1) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1,  0) == TILETYPE_DESERT) &&
                (nearby_tile_terrain_type(-1,  1) == TILETYPE_DESERT)
            ) {
        1: return CB_RESULT_LOCATION_DISALLOW;
        vineyard_tile_2_lc_1;
    }

        
    



    
        
    
        
    



    
    item(FEAT_INDUSTRYTILES, vineyard_tile_1, 243) {
        property {
            substitute:         0;
            land_shape_flags:   0;
            special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
            
            
            
            animation_triggers: bitmask();
        }

        graphics {
    		
    		    tile_check: vineyard_tile_1_lc_0;
            
            
    		
            
    		
                foundations: return CB_RESULT_NO_FOUNDATIONS;
            
    		
                autoslope: return CB_RESULT_NO_AUTOSLOPE;
            
            vineyard_switch_graphics;
        }
    }

    
    item(FEAT_INDUSTRYTILES, vineyard_tile_2, 244) {
        property {
            substitute:         0;
            land_shape_flags:   0;
            special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
            
            
            
            animation_triggers: bitmask();
        }

        graphics {
    		
    		    tile_check: vineyard_tile_2_lc_0;
            
            
    		
            
    		
    		
                autoslope: return CB_RESULT_AUTOSLOPE;
            
            vineyard_switch_graphics;
        }
    }




/* *************************************************
 * Definition of the industry
 * *************************************************/


    tilelayout vineyard_layout_1_tilelayout {
        
            0, 0: vineyard_tile_1;
        
            0, 1: vineyard_tile_1;
        
            0, 2: vineyard_tile_2;
        
            1, 0: vineyard_tile_1;
        
            1, 1: vineyard_tile_1;
        
            1, 2: vineyard_tile_1;
        
            2, 1: vineyard_tile_1;
        
            2, 2: vineyard_tile_2;
        
    }

    tilelayout vineyard_layout_2_tilelayout {
        
            0, 0: vineyard_tile_1;
        
            0, 1: vineyard_tile_1;
        
            0, 2: vineyard_tile_1;
        
            0, 3: vineyard_tile_1;
        
            1, 1: vineyard_tile_1;
        
            1, 2: vineyard_tile_1;
        
            1, 3: vineyard_tile_2;
        
            1, 4: vineyard_tile_2;
        
    }

    tilelayout vineyard_layout_3_tilelayout {
        
            0, 0: vineyard_tile_1;
        
            0, 1: vineyard_tile_1;
        
            1, 0: vineyard_tile_1;
        
            1, 1: vineyard_tile_2;
        
            2, 0: vineyard_tile_1;
        
            2, 1: vineyard_tile_2;
        
            3, 0: vineyard_tile_1;
        
            3, 1: vineyard_tile_1;
        
    }

    tilelayout vineyard_layout_4_tilelayout {
        
            0, 0: vineyard_tile_1;
        
            0, 1: vineyard_tile_1;
        
            0, 3: vineyard_tile_1;
        
            0, 4: vineyard_tile_1;
        
            1, 0: vineyard_tile_1;
        
            1, 1: vineyard_tile_1;
        
            1, 3: vineyard_tile_2;
        
            1, 4: vineyard_tile_2;
        
            3, 0: vineyard_tile_1;
        
            3, 1: vineyard_tile_1;
        
            3, 3: vineyard_tile_1;
        
            3, 4: vineyard_tile_1;
        
            4, 0: vineyard_tile_1;
        
            4, 1: vineyard_tile_1;
        
            4, 3: vineyard_tile_1;
        
            4, 4: vineyard_tile_1;
        
    }

    tilelayout vineyard_layout_5_tilelayout {
        
            0, 1: vineyard_tile_1;
        
            0, 2: vineyard_tile_1;
        
            0, 3: vineyard_tile_1;
        
            0, 4: vineyard_tile_1;
        
            1, 0: vineyard_tile_1;
        
            1, 1: vineyard_tile_1;
        
            1, 2: vineyard_tile_1;
        
            1, 3: vineyard_tile_1;
        
            1, 4: vineyard_tile_1;
        
            1, 5: vineyard_tile_1;
        
            2, 0: vineyard_tile_1;
        
            2, 1: vineyard_tile_2;
        
            2, 2: vineyard_tile_1;
        
            2, 3: vineyard_tile_1;
        
            2, 4: vineyard_tile_1;
        
            2, 5: vineyard_tile_1;
        
            3, 1: vineyard_tile_2;
        
            3, 2: vineyard_tile_1;
        
            3, 3: vineyard_tile_1;
        
            3, 4: vineyard_tile_1;
        
    }





switch(FEAT_INDUSTRIES, SELF, vineyard_extra_text, [
	STORE_TEMP((primary_level1_requirement * 1) |
	(primary_level2_requirement * 1) << 16, 0x100),
	LOAD_PERM(3)
]) {
	primary_level2_produced_percent: return string(STR_PRIMARY_PRODUCTION_4X);
	primary_level1_produced_percent: return string(STR_PRIMARY_PRODUCTION_2X);
	return string(STR_PRIMARY_PRODUCTION_1X);
}




    
    
        switch (FEAT_INDUSTRIES, SELF, vineyard_cargo_subtype_display_cargo_FMSP_economy_5, [
                LOAD_PERM(4)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
    switch (FEAT_INDUSTRIES, SELF, vineyard_cargo_subtype_display_switch_cargo_economy_5, getbits(extra_callback_info2, 16, 8)) {
        
        
            FMSP: vineyard_cargo_subtype_display_cargo_FMSP_economy_5;
        
        return CB_RESULT_NO_TEXT;
    }


switch (FEAT_INDUSTRIES, SELF, vineyard_cargo_subtype_display_switch_economy, 5) {
    
        5:  vineyard_cargo_subtype_display_switch_cargo_economy_5;
    
}


switch (FEAT_INDUSTRIES, SELF, vineyard_cargo_subtype_display, getbits(extra_callback_info2, 8, 8)) {
    1: vineyard_cargo_subtype_display_switch_economy;
    return CB_RESULT_NO_TEXT;
}





switch(FEAT_INDUSTRIES, SELF, vineyard_produce_cargototal_supplies_delivered,
    [
    
        LOAD_PERM(12)
        +
    
        LOAD_PERM(13)
        +
    
        LOAD_PERM(14)
        +
    
        LOAD_PERM(15)
        +
    
        LOAD_PERM(16)
        +
    
        LOAD_PERM(17)
        +
    
        LOAD_PERM(18)
        +
    
        LOAD_PERM(19)
        +
    
        LOAD_PERM(20)
        +
    
        LOAD_PERM(21)
        +
    
        LOAD_PERM(22)
        +
    
        LOAD_PERM(23)
        +
    
        LOAD_PERM(24)
        +
    
        LOAD_PERM(25)
        +
    
        LOAD_PERM(26)
        +
    
        LOAD_PERM(27)
        +
    
        LOAD_PERM(28)
        +
    
        LOAD_PERM(29)
        +
    
        LOAD_PERM(30)
        +
    
        LOAD_PERM(31)
        +
    
        LOAD_PERM(32)
        +
    
        LOAD_PERM(33)
        +
    
        LOAD_PERM(34)
        +
    
        LOAD_PERM(35)
        +
    
        LOAD_PERM(36)
        +
    
        LOAD_PERM(37)
        +
    
        LOAD_PERM(38)
        
    
    ]) {
    return;
}

switch(FEAT_INDUSTRIES, SELF, vineyard_produce_cargocalculate_current_production_level,
    [
         STORE_TEMP(vineyard_produce_cargototal_supplies_delivered(), 8),
         STORE_TEMP((LOAD_TEMP(8) >= (1 * primary_level2_requirement)) ? primary_level2_produced_percent :
                    (LOAD_TEMP(8) >= (1 * primary_level1_requirement)) ? primary_level1_produced_percent : 100, 9),
         STORE_PERM(3, LOAD_TEMP(9)),
    ]) {
    return 0;
}



    produce (vineyard_clear_incoming_cargo_waiting_5,
        [
            
                
                FMSP: incoming_cargo_waiting("FMSP");
            
        ],
        [],
    0)
    switch(FEAT_INDUSTRIES, SELF, vineyard_store_incoming_cargo_waiting_5,
        [
            STORE_PERM(
                38,
                
                    incoming_cargo_waiting("FMSP") + 
                
                LOAD_PERM(38)
            ),
            
            
                STORE_PERM(
                    4,
                    (incoming_cargo_waiting("FMSP") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(4)
                ),
            
            
            vineyard_produce_cargocalculate_current_production_level(),
        
            STORE_PERM(
                38,
                
                    incoming_cargo_waiting("PACK") + 
                
                LOAD_PERM(38)
            ),
            
            
                STORE_PERM(
                    4,
                    (incoming_cargo_waiting("PACK") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(4)
                ),
            
            
            vineyard_produce_cargocalculate_current_production_level(),
        ]) {
        vineyard_clear_incoming_cargo_waiting_5;
    }



switch (FEAT_INDUSTRIES, SELF, vineyard_produce_cargo_arrival, 5) {
    
        5: vineyard_store_incoming_cargo_waiting_5;
    
}




    produce(vineyard_produce_cargo256_ticks_economy_5,
        [],
        [
            
                
                BEER: (9 * production_level * LOAD_PERM(2) * LOAD_TEMP(9)) / (16 * 16 * 100);
            
                
                FRUT: (9 * production_level * LOAD_PERM(2) * LOAD_TEMP(9)) / (16 * 16 * 100);
            
        ],
    0)


switch (FEAT_INDUSTRIES, SELF, vineyard_produce_cargo256_ticks_switch_economy, 5) {

    5: vineyard_produce_cargo256_ticks_economy_5;

}


switch(FEAT_INDUSTRIES, SELF, vineyard_update_supplied_cycles_remaining_per_,
    [
        
            
            STORE_PERM(
                4,
                max(
                    0,
                    LOAD_PERM(4)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                5,
                max(
                    0,
                    LOAD_PERM(5)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                6,
                max(
                    0,
                    LOAD_PERM(6)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                7,
                max(
                    0,
                    LOAD_PERM(7)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                8,
                max(
                    0,
                    LOAD_PERM(8)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                9,
                max(
                    0,
                    LOAD_PERM(9)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                10,
                max(
                    0,
                    LOAD_PERM(10)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                11,
                max(
                    0,
                    LOAD_PERM(11)
                    - 1
                )
            ),
        
    ]) {
    return 0;
}


switch(FEAT_INDUSTRIES, SELF, vineyard_produce_cargo256_ticks_shift_supplies_delivered,
    [
        
            STORE_PERM(
                12,
                LOAD_PERM(13),
            ),
        
            STORE_PERM(
                13,
                LOAD_PERM(14),
            ),
        
            STORE_PERM(
                14,
                LOAD_PERM(15),
            ),
        
            STORE_PERM(
                15,
                LOAD_PERM(16),
            ),
        
            STORE_PERM(
                16,
                LOAD_PERM(17),
            ),
        
            STORE_PERM(
                17,
                LOAD_PERM(18),
            ),
        
            STORE_PERM(
                18,
                LOAD_PERM(19),
            ),
        
            STORE_PERM(
                19,
                LOAD_PERM(20),
            ),
        
            STORE_PERM(
                20,
                LOAD_PERM(21),
            ),
        
            STORE_PERM(
                21,
                LOAD_PERM(22),
            ),
        
            STORE_PERM(
                22,
                LOAD_PERM(23),
            ),
        
            STORE_PERM(
                23,
                LOAD_PERM(24),
            ),
        
            STORE_PERM(
                24,
                LOAD_PERM(25),
            ),
        
            STORE_PERM(
                25,
                LOAD_PERM(26),
            ),
        
            STORE_PERM(
                26,
                LOAD_PERM(27),
            ),
        
            STORE_PERM(
                27,
                LOAD_PERM(28),
            ),
        
            STORE_PERM(
                28,
                LOAD_PERM(29),
            ),
        
            STORE_PERM(
                29,
                LOAD_PERM(30),
            ),
        
            STORE_PERM(
                30,
                LOAD_PERM(31),
            ),
        
            STORE_PERM(
                31,
                LOAD_PERM(32),
            ),
        
            STORE_PERM(
                32,
                LOAD_PERM(33),
            ),
        
            STORE_PERM(
                33,
                LOAD_PERM(34),
            ),
        
            STORE_PERM(
                34,
                LOAD_PERM(35),
            ),
        
            STORE_PERM(
                35,
                LOAD_PERM(36),
            ),
        
            STORE_PERM(
                36,
                LOAD_PERM(37),
            ),
        
            STORE_PERM(
                37,
                LOAD_PERM(38),
            ),
        
        STORE_PERM(38, 0)
    ]) {
    return 0;
}

switch(FEAT_INDUSTRIES, SELF, vineyard_produce_cargo256_ticks,
    [
        
        vineyard_produce_cargocalculate_current_production_level(),
        vineyard_update_supplied_cycles_remaining_per_(),
        vineyard_produce_cargo256_ticks_shift_supplies_delivered(),
    ]) {
    vineyard_produce_cargo256_ticks_switch_economy;
}



switch(FEAT_INDUSTRIES, SELF, vineyard_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, vineyard_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	vineyard_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, vineyard_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: vineyard_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, vineyard_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): vineyard_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, vineyard_check_availability, 5) {
    
        5: vineyard_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, vineyard, 29) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 85;
                life_type: IND_LIFE_TYPE_ORGANIC;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [vineyard_layout_1_tilelayout,vineyard_layout_2_tilelayout,vineyard_layout_3_tilelayout,vineyard_layout_4_tilelayout,vineyard_layout_5_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_VINEYARD);
                prob_map_gen: 10;
                prob_in_game: 3;
                prospect_chance: 0.75;
                fund_cost_multiplier: 54;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("PACK", produce_cargo("BEER",2), produce_cargo("FRUT",1)),accept_cargo("FMSP", produce_cargo("BEER",2), produce_cargo("FRUT",1)),produce_cargo("BEER",20), produce_cargo("FRUT",10)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_WINERY));
            }
        }
    





    
        item(FEAT_INDUSTRIES, vineyard, 29) {
            graphics {
                construction_probability: vineyard_check_availability;

                
                extra_text_fund:          return string(STR_FUND_VINEYARD);
                extra_text_industry:      vineyard_extra_text;
                cargo_subtype_display:    vineyard_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

/* ******************************************************************
 * Definition of the industry tile, its callbacks, and graphics chain
 * ******************************************************************/


    

    
        
        
    

    

    

    
        
        
    

    

    

    
        
        
            spriteset(wire_and_section_mill_spriteset_2_0) {
                
                    
                        [10, 10, 64, 64, -31, -33, ANIM | NOCROP, "src/graphics/industries/wire_and_section_mill_1.png"]
                    
                
            }
            spriteset(wire_and_section_mill_spriteset_2_0_snow) {
                
                    
                            [10, 10, 64, 64, -31, -33, ANIM | NOCROP, "src/graphics/industries/wire_and_section_mill_1_snow.png"]
                    
                
            }
        
    

    

    

    
        
        
            spriteset(wire_and_section_mill_spriteset_3_0) {
                
                    
                        [80, 10, 64, 64, -31, -33, ANIM | NOCROP, "src/graphics/industries/wire_and_section_mill_1.png"]
                    
                
