            ),
        
            STORE_PERM(
                37,
                LOAD_PERM(38),
            ),
        
        STORE_PERM(38, 0)
    ]) {
    return 0;
}

switch(FEAT_INDUSTRIES, SELF, forest_produce_cargo256_ticks,
    [
        
        forest_produce_cargocalculate_current_production_level(),
        forest_update_supplied_cycles_remaining_per_(),
        forest_produce_cargo256_ticks_shift_supplies_delivered(),
    ]) {
    forest_produce_cargo256_ticks_switch_economy;
}




switch(FEAT_INDUSTRIES, SELF, forest_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, forest_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	forest_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, forest_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: forest_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, forest_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): forest_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, forest_check_availability, 5) {
    
        5: forest_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, forest, 8) {
            property {
                
                substitute: INDUSTRYTYPE_FOREST;
                override: 0;
                map_colour: 83;
                life_type: IND_LIFE_TYPE_ORGANIC;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [forest_layout_1_tilelayout,forest_layout_2_tilelayout,forest_layout_3_tilelayout,forest_layout_4_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: TTD_STR_INDUSTRY_NAME_FOREST;
                prob_map_gen: 10;
                prob_in_game: 3;
                prospect_chance: 0.75;
                fund_cost_multiplier: 95;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("ENSP", produce_cargo("WOOD",4)),produce_cargo("WOOD",30)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_FOREST));
            }
        }





    
        item(FEAT_INDUSTRIES, forest, 8) {
            graphics {
                construction_probability: forest_check_availability;

                
                extra_text_fund:          return string(STR_FUND_FOREST);
                extra_text_industry:      forest_extra_text;
                cargo_subtype_display:    forest_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }

/* ******************************************************************
 * Definition of the industry tile, its callbacks, and graphics chain
 * ******************************************************************/


    

    
        
        
    

    

    

    
        
        
            spriteset(fruit_plantation_spriteset_1_0) {
                
                    
                        [10, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_1.png"]
                    
                
            }
            spriteset(fruit_plantation_spriteset_1_0_snow) {
                
                    
                            [10, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_1_snow.png"]
                    
                
            }
        
    

    
        
        
            spriteset(fruit_plantation_spriteset_1_spriteset_default_construction_state_0) {
                
                    
                        [10, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_construction_1.png"]
                    
                
            }
        
            spriteset(fruit_plantation_spriteset_1_spriteset_default_construction_state_1) {
                
                    
                        [10, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_construction_2.png"]
                    
                
            }
        
            spriteset(fruit_plantation_spriteset_1_spriteset_default_construction_state_2) {
                
                    
                        [10, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_construction_3.png"]
                    
                
            }
        
    

    

    
        
        
            spriteset(fruit_plantation_spriteset_2_0) {
                
                    
                        [80, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_1.png"]
                    
                
            }
            spriteset(fruit_plantation_spriteset_2_0_snow) {
                
                    
                            [80, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_1_snow.png"]
                    
                
            }
        
    

    
        
        
            spriteset(fruit_plantation_spriteset_2_spriteset_default_construction_state_0) {
                
                    
                        [80, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_construction_1.png"]
                    
                
            }
        
            spriteset(fruit_plantation_spriteset_2_spriteset_default_construction_state_1) {
                
                    
                        [80, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_construction_2.png"]
                    
                
            }
        
            spriteset(fruit_plantation_spriteset_2_spriteset_default_construction_state_2) {
                
                    
                        [80, 10, 64, 59, -31, -28, ANIM | NOCROP, "src/graphics/industries/fruit_plantation_construction_3.png"]
                    
                
            }
        
    




    spritelayout fruit_plantation_house_spritelayout {
        
            
            
                
                
                    childsprite {
                        sprite: 3962;
                        hide_sprite: (LOAD_TEMP(13));
                        always_draw: 1;
                    }
                    
                    childsprite {
                        sprite: 3962;
                        hide_sprite: (!LOAD_TEMP(13));
                        always_draw: 1;
                    }
                
            
        

        
        

        
        

        
            
