        item(FEAT_INDUSTRIES, farm, 19) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 85;
                life_type: IND_LIFE_TYPE_ORGANIC;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [farm_industry_layout_1_tilelayout,farm_industry_layout_2_tilelayout,farm_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS,IND_FLAG_PLANT_FIELDS_PERIODICALLY,IND_FLAG_PLANT_FIELDS_WHEN_BUILT);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_FARM);
                prob_map_gen: 15;
                prob_in_game: 3;
                prospect_chance: 0.75;
                fund_cost_multiplier: 49;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("FMSP", produce_cargo("GRAI",3),produce_cargo("LVST",2.5)),(produce_cargo("GRAI",21)),produce_cargo("LVST",19)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_BARNS));
            }
        }






    
        item(FEAT_INDUSTRIES, farm, 19) {
            graphics {
                construction_probability: farm_check_availability;

                
                extra_text_fund:          return string(STR_FUND_FARM);
                extra_text_industry:      farm_extra_text;
                cargo_subtype_display:    farm_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }





