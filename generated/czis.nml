    switch(FEAT_INDUSTRYTILES, SELF, copper_refinery_industry_layout_1_graphics_switch, relative_pos) {
        
            
            
                relative_coord(0, 0): copper_refinery_spritelayout_transformer;
            
        
            
            
                relative_coord(0, 1): copper_refinery_spritelayout_big_shed;
            
        
            
            
