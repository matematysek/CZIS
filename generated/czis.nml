switch(FEAT_INDUSTRIES, SELF, supply_yard_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, supply_yard_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	supply_yard_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, supply_yard_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: supply_yard_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, supply_yard_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): supply_yard_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, supply_yard_check_availability, 5) {
    
        5: supply_yard_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, supply_yard, 46) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 143;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [supply_yard_industry_layout_1_tilelayout,supply_yard_industry_layout_2_tilelayout,supply_yard_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_SUPPLY_YARD);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 110;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [produce_cargo("ENSP",10),produce_cargo("FMSP",10)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_BASE));
            }
        }
    





    
        item(FEAT_INDUSTRIES, supply_yard, 46) {
            graphics {
                construction_probability: supply_yard_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      supply_yard_extra_text;
                cargo_subtype_display:    supply_yard_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

