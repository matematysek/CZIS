    produce (quarry_clear_incoming_cargo_waiting_5,
        [
            
                
                ENSP: incoming_cargo_waiting("ENSP");
            
        ],
        [],
    0)
    switch(FEAT_INDUSTRIES, SELF, quarry_store_incoming_cargo_waiting_5,
        [
            STORE_PERM(
                38,
                
                    incoming_cargo_waiting("ENSP") +
                
                LOAD_PERM(38)
            ),
            
            
                STORE_PERM(
                    4,
                    (incoming_cargo_waiting("ENSP") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(4)
                ),
            
            
            quarry_produce_cargocalculate_current_production_level(),
        ]) {
