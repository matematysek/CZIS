            3, 0: civil_explosives_facility_tile_1;
        
            3, 1: civil_explosives_facility_tile_1;
        
            3, 2: civil_explosives_facility_tile_1;
        
    }





switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_extra_text, 5) {
    
        5: return string(STR_EXTRA_TEXT_SECONDARY_NON_COMBINATORY);
    
}





    
    
        switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_cargo_subtype_display_cargo_NHNO_economy_5, [
                LOAD_PERM(3)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
        switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_cargo_subtype_display_cargo_PETR_economy_5, [
                LOAD_PERM(4)
            ]) {
            0: return 0x3800 + string(STR_EMPTY);
            return 0x3800 + string(STR_CARGO_SUBTYPE_DISPLAY_CARGO_SUPPLIED_FLAG);
        }
    
    switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_cargo_subtype_display_switch_cargo_economy_5, getbits(extra_callback_info2, 16, 8)) {
        
        
            NHNO: civil_explosives_facility_cargo_subtype_display_cargo_NHNO_economy_5;
        
            PETR: civil_explosives_facility_cargo_subtype_display_cargo_PETR_economy_5;
        
        return CB_RESULT_NO_TEXT;
    }


switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_cargo_subtype_display_switch_economy, 5) {
    
        5:  civil_explosives_facility_cargo_subtype_display_switch_cargo_economy_5;
    
}


switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_cargo_subtype_display, getbits(extra_callback_info2, 8, 8)) {
    1: civil_explosives_facility_cargo_subtype_display_switch_economy;
    return CB_RESULT_NO_TEXT;
}





switch(FEAT_INDUSTRIES, SELF, civil_explosives_facility_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	civil_explosives_facility_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: civil_explosives_facility_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): civil_explosives_facility_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, civil_explosives_facility_check_availability, 5) {
    
        5: civil_explosives_facility_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, civil_explosives_facility, 64) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 191;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [civil_explosives_facility_industry_layout_1_tilelayout,civil_explosives_facility_industry_layout_2_tilelayout,civil_explosives_facility_industry_layout_3_tilelayout,civil_explosives_facility_industry_layout_4_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_CIVIL_EXPLOSIVES_FACILITY);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 170;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("PETR", produce_cargo("ENSP", 1)),accept_cargo("NHNO", produce_cargo("ENSP", 1))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_HEAVY_INDUSTRY_2));
            }
        }






    
        item(FEAT_INDUSTRIES, civil_explosives_facility, 64) {
            graphics {
                construction_probability: civil_explosives_facility_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      civil_explosives_facility_extra_text;
                cargo_subtype_display:    civil_explosives_facility_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }


