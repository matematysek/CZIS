switch(FEAT_INDUSTRIES, SELF, sugar_refinery_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, sugar_refinery_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	sugar_refinery_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, sugar_refinery_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: sugar_refinery_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, sugar_refinery_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): sugar_refinery_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, sugar_refinery_check_availability, 5) {
    
        5: sugar_refinery_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, sugar_refinery, 65) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 83;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [sugar_refinery_industry_layout_1_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS,IND_FLAG_MILITARY_AIRPLANE_CAN_EXPLODE);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_SUGAR_REFINERY);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 140;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("PACK"),accept_cargo("SGBT",produce_cargo("FOOD",0))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_SUGAR_COMPANY));
            }
        }
    





    
        item(FEAT_INDUSTRIES, sugar_refinery, 65) {
            graphics {
                construction_probability: sugar_refinery_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      sugar_refinery_extra_text;
                cargo_subtype_display:    sugar_refinery_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

