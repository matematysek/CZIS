}







    
        item(FEAT_INDUSTRIES, fruit_plantation, 20) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 207;
                life_type: IND_LIFE_TYPE_ORGANIC;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [fruit_plantation_layout_1_tilelayout,fruit_plantation_layout_2_tilelayout,fruit_plantation_layout_3_tilelayout,fruit_plantation_layout_4_tilelayout,fruit_plantation_layout_5_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: TTD_STR_INDUSTRY_NAME_FRUIT_PLANTATION;
                prob_map_gen: 10;
                prob_in_game: 4;
                prospect_chance: 0.75;
                fund_cost_multiplier: 54;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types:  [accept_cargo("FMSP", produce_cargo("FRUT",2.5)),produce_cargo("FRUT",20)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_PLANTATION));
            }
        }





    
        item(FEAT_INDUSTRIES, fruit_plantation, 20) {
            graphics {
                construction_probability: fruit_plantation_check_availability;

                
                extra_text_fund:          return string(STR_FUND_FRUIT_PLANTATION);
                extra_text_industry:      fruit_plantation_extra_text;
                cargo_subtype_display:    fruit_plantation_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }

