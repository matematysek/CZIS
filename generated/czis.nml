            1, 2: forest_tile_1;
        
            1, 3: forest_tile_1;
        
            2, 0: forest_tile_1;
        
            2, 1: forest_tile_1;
        
            2, 2: forest_tile_1;
        
            2, 3: forest_tile_1;
        
            3, 0: forest_tile_1;
        
            3, 1: forest_tile_2;
        
            3, 2: forest_tile_2;
        
            3, 3: forest_tile_1;
        
    }

    tilelayout forest_layout_4_tilelayout {
        
            0, 0: forest_tile_1;
        
