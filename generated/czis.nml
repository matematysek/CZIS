            1, 1: orchard_piggery_tile_1;
        
            2, 0: orchard_piggery_tile_2;
        
            2, 1: orchard_piggery_tile_2;
        
            3, 0: orchard_piggery_tile_1;
        
            3, 1: orchard_piggery_tile_2;
        
    }

    tilelayout orchard_piggery_layout_4_tilelayout {
        
            0, 0: orchard_piggery_tile_1;
        
