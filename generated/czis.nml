        item(FEAT_INDUSTRIES, dairy, 24) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 169;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [dairy_industry_layout_1_tilelayout,dairy_industry_layout_2_tilelayout,dairy_industry_layout_3_tilelayout,dairy_industry_layout_4_tilelayout,dairy_industry_layout_5_tilelayout,dairy_industry_layout_6_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS,IND_FLAG_MILITARY_HELICOPTER_CAN_EXPLODE);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_DAIRY);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 45;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("PACK"),accept_cargo("MILK", produce_cargo("FOOD",1))];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_DAIRY_LANE));
            }
        }






    
        item(FEAT_INDUSTRIES, dairy, 24) {
