}


switch (FEAT_INDUSTRIES, SELF, forest_cargo_subtype_display, getbits(extra_callback_info2, 8, 8)) {
    1: forest_cargo_subtype_display_switch_economy;
    return CB_RESULT_NO_TEXT;
}





