        item(FEAT_INDUSTRIES, cement_plant, 45) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 19;
                life_type: IND_LIFE_TYPE_PROCESSING;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [cement_plant_industry_layout_1_tilelayout,cement_plant_industry_layout_2_tilelayout,cement_plant_industry_layout_3_tilelayout,cement_plant_industry_layout_4_tilelayout,cement_plant_industry_layout_5_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS,IND_FLAG_MILITARY_HELICOPTER_CAN_EXPLODE);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_CEMENT_PLANT);
                prob_map_gen: 5;
                prob_in_game: 3;
                
                fund_cost_multiplier: 203;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("COAL"),accept_cargo("GRVL"),accept_cargo("QLME", produce_cargo("CMNT", 1)),accept_cargo("SAND", produce_cargo("BDMT", 1))];

				nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_SILO));
            }
        }






    
        item(FEAT_INDUSTRIES, cement_plant, 45) {
            graphics {
                construction_probability: cement_plant_check_availability;
                random_prod_change:       CB_RESULT_IND_PROD_NO_CHANGE;
                extra_text_fund:          return CB_RESULT_NO_TEXT;
                extra_text_industry:      cement_plant_extra_text;
                cargo_subtype_display:    cement_plant_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }


