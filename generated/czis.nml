        [
            STORE_PERM(
                35,
                
                    incoming_cargo_waiting("FOOD") +
                
                    incoming_cargo_waiting("BEER") +
                
                    incoming_cargo_waiting("PASS") +
                
                LOAD_PERM(35)
            ),
            
            
                STORE_PERM(
                    1,
                    (incoming_cargo_waiting("FOOD") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(1)
                ),
            
                STORE_PERM(
                    2,
                    (incoming_cargo_waiting("BEER") > 0)
                    ?
                    28
                    :
