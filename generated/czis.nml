            0, 3: orchard_piggery_tile_1;
        
            0, 4: orchard_piggery_tile_1;
        
            1, 0: orchard_piggery_tile_1;
        
            1, 1: orchard_piggery_tile_1;
        
            1, 3: orchard_piggery_tile_1;
        
            1, 4: orchard_piggery_tile_1;
        
            3, 0: orchard_piggery_tile_1;
        
            3, 1: orchard_piggery_tile_1;
        
            3, 3: orchard_piggery_tile_2;
        
            3, 4: orchard_piggery_tile_1;
        
            4, 0: orchard_piggery_tile_1;
        
            4, 1: orchard_piggery_tile_2;
        
            4, 3: orchard_piggery_tile_1;
        
            4, 4: orchard_piggery_tile_2;
        
    }





switch(FEAT_INDUSTRIES, SELF, orchard_piggery_extra_text, [
	STORE_TEMP((primary_level1_requirement * 1) |
	(primary_level2_requirement * 1) << 16, 0x100),
	LOAD_PERM(3)
]) {
	primary_level2_produced_percent: return string(STR_PRIMARY_PRODUCTION_4X);
	primary_level1_produced_percent: return string(STR_PRIMARY_PRODUCTION_2X);
	return string(STR_PRIMARY_PRODUCTION_1X);
}




    
    
        switch (FEAT_INDUSTRIES, SELF, orchard_piggery_cargo_subtype_display_cargo_FMSP_economy_5, [
