            ),
        
            STORE_PERM(
                37,
                LOAD_PERM(38),
            ),
        
        STORE_PERM(38, 0)
    ]) {
    return 0;
}

switch(FEAT_INDUSTRIES, SELF, dairy_farm_produce_cargo256_ticks,
    [
        
        dairy_farm_produce_cargocalculate_current_production_level(),
        dairy_farm_update_supplied_cycles_remaining_per_(),
        dairy_farm_produce_cargo256_ticks_shift_supplies_delivered(),
    ]) {
    dairy_farm_produce_cargo256_ticks_switch_economy;
}



switch(FEAT_INDUSTRIES, SELF, dairy_farm_check_availability_param, restrict_open_during_gameplay) {
	1..255: return CB_RESULT_IND_NO_CONSTRUCTION;         // disallow when restrictions in place
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;       // we may build
}


switch (FEAT_INDUSTRIES, SELF, dairy_farm_check_map_gen, extra_callback_info2 == IND_CREATION_GENERATION) {
	1: return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
	dairy_farm_check_availability_param;
}

switch (FEAT_INDUSTRIES, SELF, dairy_farm_available_game_mode, game_mode == GAMEMODE_GAME) {
	1: dairy_farm_check_map_gen;
	return CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
}



    /* 0 */
    switch (FEAT_INDUSTRIES, SELF, dairy_farm_check_availability_5, current_date) {
        date(0,1,1) .. date(5000000,12,31): dairy_farm_available_game_mode;
        return CB_RESULT_IND_NO_CONSTRUCTION;
    }


switch (FEAT_INDUSTRIES, SELF, dairy_farm_check_availability, 5) {
    
        5: dairy_farm_check_availability_5;
    
}







    
        item(FEAT_INDUSTRIES, dairy_farm, 18) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 164;
                life_type: IND_LIFE_TYPE_ORGANIC;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [dairy_farm_industry_layout_1_tilelayout,dairy_farm_industry_layout_2_tilelayout,dairy_farm_industry_layout_3_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS,IND_FLAG_PLANT_FIELDS_PERIODICALLY,IND_FLAG_PLANT_FIELDS_WHEN_BUILT);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_DAIRY_FARM);
                prob_map_gen: 11;
                prob_in_game: 3;
                prospect_chance: 0.75;
                fund_cost_multiplier: 60;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types:[accept_cargo("FMSP", produce_cargo("LVST",1.5),produce_cargo("MILK",3)),(produce_cargo("LVST",12)),produce_cargo("MILK",25)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_FARM_2));
            }
        }






    
        item(FEAT_INDUSTRIES, dairy_farm, 18) {
            graphics {
                construction_probability: dairy_farm_check_availability;

                
                extra_text_fund:          return string(STR_FUND_DAIRY_FARM);
                extra_text_industry:      dairy_farm_extra_text;
                cargo_subtype_display:    dairy_farm_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }


