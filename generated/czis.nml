}

switch(FEAT_INDUSTRIES, SELF, dairy_farm_produce_cargocalculate_current_production_level,
    [
         STORE_TEMP(dairy_farm_produce_cargototal_supplies_delivered(), 8),
         STORE_TEMP((LOAD_TEMP(8) >= (1 * primary_level2_requirement)) ? primary_level2_produced_percent :
                    (LOAD_TEMP(8) >= (1 * primary_level1_requirement)) ? primary_level1_produced_percent : 100, 9),
         STORE_PERM(3, LOAD_TEMP(9)),
    ]) {
    return 0;
}



    produce (dairy_farm_clear_incoming_cargo_waiting_5,
        [
            
                
                FMSP: incoming_cargo_waiting("FMSP");
            
        ],
        [],
    0)
    switch(FEAT_INDUSTRIES, SELF, dairy_farm_store_incoming_cargo_waiting_5,
        [
            STORE_PERM(
                38,
                
                    incoming_cargo_waiting("FMSP") +
                
                LOAD_PERM(38)
            ),
            
            
                STORE_PERM(
                    4,
                    (incoming_cargo_waiting("FMSP") > 0)
                    ?
                    28
                    :
                    LOAD_PERM(4)
                ),
            
            
            dairy_farm_produce_cargocalculate_current_production_level(),
        ]) {
        dairy_farm_clear_incoming_cargo_waiting_5;
    }



switch (FEAT_INDUSTRIES, SELF, dairy_farm_produce_cargo_arrival, 5) {
    
        5: dairy_farm_store_incoming_cargo_waiting_5;
    
}




    produce(dairy_farm_produce_cargo256_ticks_economy_5,
        [],
        [
            
                
                LVST: (12 * production_level * LOAD_PERM(2) * LOAD_TEMP(9)) / (16 * 16 * 100);
            
                
                MILK: (14 * production_level * LOAD_PERM(2) * LOAD_TEMP(9)) / (16 * 16 * 100);
            
        ],
    0)


switch (FEAT_INDUSTRIES, SELF, dairy_farm_produce_cargo256_ticks_switch_economy, 5) {

    5: dairy_farm_produce_cargo256_ticks_economy_5;

}


switch(FEAT_INDUSTRIES, SELF, dairy_farm_update_supplied_cycles_remaining_per_,
    [
        
            
            STORE_PERM(
                4,
                max(
                    0,
                    LOAD_PERM(4)
                    - 1
                )
            ),
        
            
            STORE_PERM(
                5,
                max(
                    0,
                    LOAD_PERM(5)
                    - 1
                )
            ),
        
            
            STORE_PERM(
