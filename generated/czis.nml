        item(FEAT_INDUSTRIES, orchard_piggery, 32) {
            property {
                
                substitute: 0;
                override: 0;
                map_colour: 85;
                life_type: IND_LIFE_TYPE_ORGANIC;
                
                
                
                
                min_cargo_distr: 1;
                layouts: [orchard_piggery_layout_1_tilelayout,orchard_piggery_layout_2_tilelayout,orchard_piggery_layout_3_tilelayout,orchard_piggery_layout_4_tilelayout];
                spec_flags: bitmask(IND_FLAG_LONG_CARGO_TYPE_LISTS);
                conflicting_ind_types: []; // set this prop empty, FIRS has it's own better checks for this
                random_sound_effects: []; // set this empty to avoid spurious default industry sounds (as of May 2017 FIRS does not yet use sound effects)
                
                name: string(STR_IND_ORCHARD_PIGGERY);
                prob_map_gen: 11;
                prob_in_game: 4;
                prospect_chance: 0.75;
                fund_cost_multiplier: 54;
                remove_cost_multiplier: 0;
                remove_cost_multiplier: 0;
                
                cargo_types: [accept_cargo("FMSP", produce_cargo("FRUT",2.5), produce_cargo("LVST",2)), produce_cargo("FRUT",25), produce_cargo("LVST", 10)];
                nearby_station_name: string(STR_STATION, string(STR_TOWN),string(STR_STATION_ORCHARDS));
            }
        }
    





    
        item(FEAT_INDUSTRIES, orchard_piggery, 32) {
            graphics {
                construction_probability: orchard_piggery_check_availability;

                
                extra_text_fund:          return string(STR_FUND_ORCHARD_PIGGERY);
                extra_text_industry:      orchard_piggery_extra_text;
                cargo_subtype_display:    orchard_piggery_cargo_subtype_display;
                colour:                   switch_colour;
            }
        }
    

