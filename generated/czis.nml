            }
        
    

    

    

    
        
        
            spriteset(machine_works_spriteset_4_0) {
                
                    
                        [150, 60, 64, 70, -31, -39, ANIM | NOCROP, "src/graphics/industries/machine_works_1.png"]
                    
                
            }
            spriteset(machine_works_spriteset_4_0_snow) {
                
                    
                            [150, 60, 64, 70, -31, -39, ANIM | NOCROP, "src/graphics/industries/machine_works_1_snow.png"]
                    
                
            }
        
    

    

    

    
        
        
            spriteset(machine_works_spriteset_5_0) {
                
                    
                        [220, 60, 64, 70, -31, -39, ANIM | NOCROP, "src/graphics/industries/machine_works_1.png"]
                    
                
            }
            spriteset(machine_works_spriteset_5_0_snow) {
                
                    
